# Copy to .env for local development. Never commit .env - .gitignore already
# excludes it. In production these are Fly secrets (`fly secrets set ...`).

# --- Database -----------------------------------------------------------------
# Matches the `db` service in docker-compose.yml. Required in production: the
# app refuses to boot without it rather than falling back to localhost and
# failing every sign-in after a green deploy.
DATABASE_URL=postgres://padelfinder:padelfinder@localhost:5432/padelfinder?sslmode=disable

# The auth tests need a real Postgres, because the guarantees they check *are*
# Postgres statements. Without this they are skipped rather than failed, so the
# availability tests still run on a machine with no database.
#
# With a Homebrew Postgres (see README), both databases live on 5432:
DATABASE_URL_TEST=postgres://padelfinder:padelfinder@localhost:5432/padelfinder_test?sslmode=disable
# With docker-compose, the throwaway `db-test` service is on 5433 instead:
# DATABASE_URL_TEST=postgres://padelfinder:padelfinder@localhost:5433/padelfinder_test?sslmode=disable

# --- Tokens -------------------------------------------------------------------
# HMAC key for the 15-minute access token. REQUIRED in production - boot fails
# without it. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=padelfinder
JWT_AUDIENCE=padelfinder-app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# --- Emailed codes ------------------------------------------------------------
# `log` writes the code to the console instead of sending it - the right choice
# for local development: the whole sign-up flow works with no provider account
# and no key. `resend` actually sends.
OTP_MAILER=log

# Only read when OTP_MAILER=resend, and then REQUIRED - the app refuses to boot
# without it rather than dropping sign-ups silently. Create one at
# resend.com/api-keys, and set it with `fly secrets set` in production. It never
# needs to be committed or shared.
# Leave this EMPTY here. This file is committed - it is the one .env* path
# .gitignore deliberately does not exclude. Real keys go in .env (ignored)
# or `fly secrets set`, never here.
RESEND_API_KEY=

# Who the code appears to come from.
#
# Resend's test sender `onboarding@resend.dev` works the moment you have a key,
# with no domain and no DNS - but it only delivers to the address the Resend
# account was registered with. Enough to test on a device; useless for real
# users. The server logs a warning while it is still in use.
#
# For real users: verify a domain you own in Resend, add the SPF, DKIM and DMARC
# records it gives you, then put that address here. Without those records the
# code does not bounce - it lands in spam, the API still answers 202, and
# sign-up is broken with no error anywhere.
OTP_FROM_ADDRESS=PadelFinder <onboarding@resend.dev>
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_SENDS_PER_HOUR=5
# Per-IP cap on code requests. This is the only thing standing between
# /auth/register - which takes no authentication - and the provider's whole
# daily quota, since unique addresses never meet the per-address cap.
OTP_SENDS_PER_HOUR_PER_IP=20

# Header carrying the real client IP, set by a proxy we trust. Unset means
# trust no header and use the socket address, which is the safe default: any
# client can send X-Forwarded-For, so trusting a header by default would make
# the per-IP cap meaningless. On Fly this is already set in fly.toml.
# TRUSTED_CLIENT_IP_HEADER=Fly-Client-IP

# --- Sign in with Apple / Google ---------------------------------------------
# Accepted `aud` values, comma-separated: the iOS bundle id, plus a Services ID
# or web client id if those flows are added. Left empty, the matching endpoint
# answers 503 `provider_not_configured` rather than accepting anything.
#
# These are public identifiers, not secrets - which is why they live here and
# in fly.toml's [env] rather than in `fly secrets`. Casing matters: Apple's
# `aud` is the bundle id exactly as registered, and `commaSeparated` trims
# whitespace but does not lowercase.
#
# Apple needs only the iOS bundle id: the server verifies the native identity
# token against Apple's public JWKS, so there is no Services ID and no client
# secret in this flow.
APPLE_CLIENT_IDS=GR.PadelFinder
# The iOS OAuth client id from Google Cloud Console - it is the real `aud` of
# the token the device receives. Shape:
#   GOOGLE_CLIENT_IDS=000000000000-abcdefghijklmnop.apps.googleusercontent.com
# A web client id gets appended to the list only if a web front end appears.
GOOGLE_CLIENT_IDS=

# --- Existing -----------------------------------------------------------------
PUBLIC_BASE_URL=http://127.0.0.1:8080
LOG_LEVEL=debug
